# Supabase — proyecto creado en https://supabase.com
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# Anthropic — opcional. Si no se configura, FOA usa un clasificador
# heurístico de respaldo para interpretar los mensajes del trabajador.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# WhatsApp Cloud API — preparado para integración futura, no usado en el MVP.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERIFY_TOKEN=
